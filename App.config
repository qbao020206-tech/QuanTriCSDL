<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	<appSettings>
		<add key="ServerName" value="localhost" />
		<!-- Thay bằng tên Server SQL của bạn -->
		<add key="Admin-PC" value="QLY_CONGCAFFE" />
	</appSettings>
</configuration>